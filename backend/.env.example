# Bu dosyayı .env olarak kopyala; yalnızca değiştirmek istediğin satırları aç.
# Hiçbiri zorunlu değil, yorumdaki değerler varsayılanlardır.

# İzin verilen alan adları (www. alt alan adları otomatik eklenir).
# ALLOWED_HOSTS=youtube.com,youtu.be,m.youtube.com,music.youtube.com,instagram.com

# Çözünürlük sınırları (kısa kenara göre; dikey 1080x1920 = 1080p).
# MAX_HEIGHT=1080
# MIN_HEIGHT=360

# Video ve dosya sınırları.
# MAX_DURATION_MINUTES=90
# MAX_MEGABYTES=2048
# DOWNLOAD_TIMEOUT_MINUTES=15

# Eşzamanlılık. Dolu slotta kuyruk yok, istek 503 ile anında reddedilir.
# MAX_CONCURRENT_DOWNLOADS=3
# MAX_CONCURRENT_INFO=2
# IP başına eşzamanlı indirme; 0 = sınırsız (yalnızca test için).
# MAX_DOWNLOADS_PER_IP=1

# /api/info önbelleği (video kimliği bazında).
# CACHE_TTL_MINUTES=25
# CACHE_MAX_ENTRIES=200

# Instagram çerez dosyası; göreli yol backend/ klasörüne göredir.
# Dosya yoksa çerezsiz devam edilir (reels çalışır, hikâyeler çalışmaz).
# INSTAGRAM_COOKIES=./cookies.txt

# ffmpeg / ffprobe PATH'te değilse tam yol.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
