# Bu dosyayı .env olarak kopyala; yalnızca değiştirmek istediğin satırları aç.
# Hiçbiri zorunlu değil, yorumdaki değerler varsayılanlardır.

# İzin verilen alan adları (www. alt alan adları otomatik eklenir).
# ALLOWED_HOSTS=youtube.com,youtu.be,m.youtube.com,music.youtube.com,instagram.com

# Çözünürlük sınırları (kısa kenara göre; dikey 1080x1920 = 1080p).
# MAX_HEIGHT=1080
# MIN_HEIGHT=360

# Video ve dosya sınırları.
# MAX_DURATION_MINUTES=90
# MAX_MEGABYTES=2048
# İndirme süresi: üst süre en az DOWNLOAD_TIMEOUT_MINUTES, büyük dosyada
# boyut ÷ MIN_DOWNLOAD_KBPS kadar uzar. DOWNLOAD_STALL_SECONDS boyunca
# tek bayt akmazsa (kaynak durdu ya da istemci okumuyor) indirme kesilir; en az 10
# ve RESERVATION_TTL_SECONDS'tan büyük olmalı.
# DOWNLOAD_TIMEOUT_MINUTES=15
# MIN_DOWNLOAD_KBPS=256
# DOWNLOAD_STALL_SECONDS=120

# Eşzamanlılık. Dolu slotta kuyruk yok, istek 503 ile anında reddedilir.
# MAX_CONCURRENT_DOWNLOADS=3
# MAX_CONCURRENT_INFO=2
# IP başına eşzamanlı indirme (IPv6'da /64 bloğu başına); 0 = sınırsız (yalnızca test için).
# MAX_DOWNLOADS_PER_IP=1
# Yeni link çözümleme (önbellekte olmayan) için IP başına eşzamanlılık ve dakikalık sınır.
# MAX_INFO_PER_IP=1
# INFO_PER_MINUTE_PER_IP=20

# /api/download/prepare ile ayrılıp indirilmeyen yer bu sürede boşalır (sn).
# RESERVATION_TTL_SECONDS=30

# /api/info önbelleği (video kimliği bazında) ve kapak önbelleği (bellekte).
# CACHE_TTL_MINUTES=25
# CACHE_MAX_ENTRIES=200
# THUMBNAIL_CACHE_MEGABYTES=32

# Carousel gönderide çözümlenecek en fazla girdi.
# PLAYLIST_LIMIT=10

# MP3 sabit bit hızı (kbps, 32–320). CBR: akışla üretilen dosyada süre her oynatıcıda doğru.
# MP3_BITRATE_KBPS=192

# Instagram çerez dosyası; göreli yol backend/ klasörüne göredir.
# Dosya yoksa çerezsiz devam edilir (reels çalışır, hikâyeler çalışmaz).
# INSTAGRAM_COOKIES=./cookies.txt

# ffmpeg / ffprobe PATH'te değilse tam yol.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# --- python serve.py ---
# HOST=127.0.0.1
# PORT=8000
# X-Forwarded-For'una güvenilen reverse proxy'ler (virgülle, CIDR olabilir).
# Yalnızca bu adreslerden gelen istekte başlık okunur; sahte IP ile sınır atlatılamaz.
# FORWARDED_ALLOW_IPS=127.0.0.1,::1
# Kapanırken süren indirmeler en fazla bu kadar beklenir (sn); systemd TimeoutStopSec'ten kısa olmalı.
# SHUTDOWN_TIMEOUT_SECONDS=20
